# Byte-compiled / optimized / DLL files
__pycache__/
**/__pycache__/
*.py[cod]
*$py.class

# Virtual environments
venv/
.venv/
env/
**/venv/
**/.venv/
**/env/

# Python test & lint caches
.pytest_cache/
**/.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
*.egg-info/

# Node & Frontend dependencies & builds
node_modules/
**/node_modules/
dist/
**/dist/
dist-ssr/
.vite/
**/.vite/

# User uploads & media files
uploads/
**/uploads/*
!**/uploads/.gitkeep

# Environment variables & secrets
.env
.env.*
!.env.example

# Logs & temporary files
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# IDE & Editor files
.vscode/
!.vscode/extensions.json
.idea/
*.swp
*.swo
*.suo

# OS generated files
.DS_Store
Thumbs.db
